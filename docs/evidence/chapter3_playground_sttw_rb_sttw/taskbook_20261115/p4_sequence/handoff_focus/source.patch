+        self.assertAlmostEqual(bias.item(),1/3,places=6)
+        opposite=q.clone();opposite[...,3:7]*=-1
+        _,equivalent=handoff_focus_loss(opposite,v,correct,q,v,phase,onset)
+        self.assertEqual(equivalent.item(),0.)
