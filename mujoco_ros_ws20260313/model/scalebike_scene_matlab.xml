    <key name="mu01" qpos="0 0 0.244 0.669087380370861 0.7431595238308237 -0.004014572457210272 0.004459010651241177 0.2618 0 0 0" 
      qvel="1.28 0.48 0 -0.0083998  -0.69610906  0.07322307 0 -13 0 -16" />
    <key name="mu02" qpos="0 0 0.244 0.7070927546507347 0.7070953519522198 -0.004242607439315867 0.004242623023311787 0.2618 0 0 0" 
