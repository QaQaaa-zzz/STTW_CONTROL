float64 time        # 单位 s
float64 steer_pos   # 车把转角，单位 rad，左打方向为正方向
float64 roll_ang    # 车体倾角，单位 rad，右倾为正
float64 steer_vel   # 车把角速度，单位 rad/s，左打为正
float64 roll_vel    # 车体倾角速度，单位 rad/s，右倾为正
float64 yaw_vel   # 车体偏航角速度，单位 rad/s，俯视逆时针为正（与平衡控制无关）
float64 rear_vel    # 后轮转速，单位 rad/s，前进为正
float64 front_vel   # 前轮转速，单位 rad/s，前进为正（与平衡控制无关）